# Local database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Test database (SQLite)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Secret keys
ACCESS_SECRET_KEY=your_access_secret_key
RESET_PASSWORD_SECRET_KEY=your_reset_password_secret_key
VERIFICATION_SECRET_KEY=your_verification_secret_key

# OpenAPI genrated file output path
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# Localhost Email configuration
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Gmail ingestion
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_PUBSUB_TOPIC_NAME=projects/your-google-cloud-project/topics/gmail
GMAIL_WEBHOOK_TOKEN=change-me

# OpenAI email triage
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_EMAIL_TRIAGE_MODEL=gpt-5
OPENAI_EMAIL_TRIAGE_ON_WEBHOOK=False

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/emails/gmail/oauth/callback

# Frontend (NextJS)
FRONTEND_URL=http://localhost:3000

# CORS (Allow all origins for development; adjust this to restrict origins in production deployments)
CORS_ORIGINS=["*"]

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""
